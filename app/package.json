{
  "name": "antirl-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "pnpm test:unit && playwright test",
    "test:unit": "node ../scripts/test-ranks-quality.mjs",
    "lint": "eslint src tests && tsc --noEmit",
    "format": "prettier --write src tests index.html package.json *.ts *.js",
    "format:check": "prettier --check src tests index.html package.json *.ts *.js",
    "types:generate": "cargo test -p antirl export_ipc_bindings --manifest-path ../Cargo.toml"
  },
  "dependencies": {
    "@babylonjs/core": "^8.31.0",
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3"
  },
  "packageManager": "pnpm@11.3.0"
}
