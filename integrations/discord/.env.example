# Never commit a filled .env. Local HTTP listener needs a public HTTPS proxy for Discord.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Only register.mjs reads this token. The signed HTTP server does not need it.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_GUILDS=
PORT=49201
ANTIRL_REPLAY_EXE=C:/Users/barke/Documents/AntiRL/target/release/antirl-replay.exe
ANTIRL_DISCORD_DATA=C:/Users/barke/Documents/AntiRL/.local/discord
